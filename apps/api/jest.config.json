{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": "src",
  "testRegex": ".*\\.spec\\.ts$",
  "transform": {
    "^.+\\.[tj]s$": [
      "<rootDir>/../jest-transformer.cjs"
    ]
  },
  "testEnvironment": "node",
  "transformIgnorePatterns": [
    "/node_modules/(?!.*@nestjs)"
  ]
}
