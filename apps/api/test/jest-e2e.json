{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testRegex": "test/.+\\.e2e-spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": ["<rootDir>/jest-transformer.cjs"]
  },
  "transformIgnorePatterns": ["/node_modules/(?!.*@nestjs)"],
  "testEnvironment": "node",
  "testTimeout": 60000
}
